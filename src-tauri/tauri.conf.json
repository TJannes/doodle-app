{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doodle",
  "version": "0.1.0",
  "identifier": "app.doodle.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Doodle",
        "width": 1440,
        "height": 960,
        "fullscreen": true,
        "decorations": false,
        "resizable": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Doodle",
    "shortDescription": "Simple drawing app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Dutch"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0NUQ0RjJGQUNGNTJGMDIKUldRQ0wvV3NMMDlkNVBZU1E1bXlrenkzQXBwSUxrYkJsWmE0T0xNVld1NjZ1MnlLdytMMUxmSnoK",
      "endpoints": [
        "https://github.com/TJannes/doodle-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
